# secret used to sign/verify auth JWTs, keep this private and long/random in production
JWT_SECRET=change-me-to-a-long-random-string

# MySQL connection - the database is created automatically on first boot if it doesn't exist
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nafyn

# Nafyn downloads through a self-hosted slskd instance (https://github.com/slskd/slskd), not the raw Soulseek network directly.
# URL of your slskd instance's web/API port (default port: 5030)
SOULSEEK_HOST=http://127.0.0.1:5030
# slskd web UI login, create a dedicated/throwaway account on it, never reuse a personal Soulseek login
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
# local, readable path to slskd's own downloads directory (e.g. an SMB/NFS mount if slskd runs on another machine).
# required because slskd's API can drive downloads but doesn't serve the finished file's bytes back over HTTP.
SOULSEEK_DOWNLOADS_PATH=

# AcoustID client API key (free, get one at https://acoustid.org/my-applications), used to verify downloaded audio actually matches the requested MusicBrainz recording
ACOUSTID_API_KEY=
# How strictly a download is judged against the requested recording (all optional, these are the defaults).
# Nafyn always re-fingerprints the downloaded audio and measures its duration itself, then scores every candidate AcoustID returns.
# minimum AcoustID score (0-1) for a candidate to count at all
# NAFYN_ACOUSTID_MIN_SCORE=0.7
# seconds a candidate recording's length may differ from the measured audio before it is treated as a different recording
# NAFYN_ACOUSTID_DURATION_TOLERANCE=5
# merged-away MusicBrainz IDs looked up per file to see whether a candidate is the requested recording
# NAFYN_ACOUSTID_MAX_ALIAS_LOOKUPS=3

# Soulseek search pacing (optional, these are the defaults). Every pipeline's searches go through one gate: at most
# this many in flight, started at least this many milliseconds apart. Bursts of searches get throttled by the
# Soulseek server, and a throttled search looks exactly like "nobody shares this song".
# NAFYN_SLSKD_MAX_CONCURRENT_SEARCHES=3
# NAFYN_SLSKD_SEARCH_INTERVAL_MS=1000

# Pause (seconds) between one download request finishing and the next one in the queue starting (optional,
# default 7). Back-to-back requests get throttled by Soulseek and a throttled search looks like "nobody has it".
# 0 turns the pause off.
# NAFYN_DOWNLOAD_COOLDOWN_SECONDS=7

# How many requests one account may have waiting or downloading at once (optional, default 500). Past it,
# POST /api/v1/request answers 429 and a playlist import waits for some to finish.
# NAFYN_MAX_ACTIVE_REQUESTS_PER_USER=500

# Artist bios and pictures come from TheAudioDB (a picture it doesn't have comes from the Wikidata item
# MusicBrainz links to the artist, through Wikimedia Commons). TheAudioDB works with its free public key "123"
# (30 requests a minute, which is the default); a paid key from https://www.theaudiodb.com/free_music_api lifts
# that limit. Listener counts come from ListenBrainz, and users scrobble to ListenBrainz with their own user
# token: neither needs anything here.
# THEAUDIODB_API_KEY=123

# Comma-separated hostnames whose resolved IPs are exempt from the login/register rate limits.
# Leave empty unless you specifically need it - every entry here is an IP that can brute-force passwords freely.
DOMAINS_WHITELIST=

# Number of reverse proxies in front of Nafyn (nginx/Caddy/Traefik/Cloudflare). Leave at 0 when Nafyn is
# directly exposed. This gates whether X-Forwarded-For is trusted at all: with it wrong (or unset behind a
# proxy) every client shares one rate-limit bucket; with it set while NOT behind a proxy, anyone can forge
# the header and bypass rate limiting entirely.
TRUST_PROXY=0

# Set to "true" to publish the auto-generated OpenAPI spec and Scalar docs UI in production.
# Off by default: the spec enumerates every endpoint, parameter and auth requirement to anonymous visitors.
NAFYN_PUBLIC_OPENAPI=false

# GDPR art. 13: the privacy notice at /privacy ships with Nafyn, but only you know who is running this
# instance and how to be reached about personal data. Both are optional - the page then tells visitors
# plainly that no contact details were published, which is worse than filling them in.
# Name of the person/organisation running this instance (the data controller)
NAFYN_PRIVACY_CONTROLLER=
# How to reach them about data requests: an email address, a URL, anything a person can act on
NAFYN_PRIVACY_CONTACT=

# Set to "false" to stop this replica running the retention sweeps (server/plugins/retentionJobs.ts).
# Leave unset on a single-instance install - the sweeps are what keep data from being kept longer than it
# is needed (GDPR art. 5(1)(e)), so at least one replica must be running them.
NAFYN_RETENTION_SCHEDULER=

# Set to "false" to stop this replica resuming interrupted playlist imports at boot (server/plugins/importJobs.ts).
# Imports run in-process like downloads: leave it on for the one instance that serves the API.
NAFYN_IMPORT_WORKER=

# Public URL of this Nafyn instance (e.g. https://music.example.com). Optional: used to put "Open in Nafyn"
# links in webhook messages and push notifications. Without it, notifications simply carry no link.
NAFYN_PUBLIC_URL=

# Webhooks (Settings -> Notifications for personal ones, Settings -> Webhooks for instance-wide ones under the
# MANAGE_WEBHOOKS permission). Webhook URLs must be https and resolve to a public address - any account can add
# one, so the server refuses to POST into its own network. Set to "true" to let *instance* webhooks (never
# personal ones) target private/LAN addresses and plain http, e.g. a local Home Assistant or ntfy.
NAFYN_WEBHOOK_ALLOW_PRIVATE=false

# Apple Push Notifications (APNs), used by the Nafyn iOS app for notifications, Live Activities and Now Playing
# remote sessions. Leave the key/team ids empty to disable APNs entirely (every push is then skipped silently).
# The .p8 auth key is looked up in APN_KEY_DIR (AuthKey_<APN_KEY_ID>.p8 first, otherwise the only .p8 there).
# 10-character Key ID of the .p8 auth key (Apple Developer -> Certificates, IDs & Profiles -> Keys)
APN_KEY_ID=
# 10-character Team ID (Apple Developer -> Membership details)
APN_TEAM_ID=
# bundle identifier of the iOS app; Live Activity / Now Playing topics are derived from it
APN_BUNDLE_ID=fr.lumaa.Nafyn
# directory holding the .p8 key, relative to the working directory
APN_KEY_DIR=.
# environment used by raw sends that don't come with a registered token's own environment
# ("true" = production gateway, otherwise sandbox). Registered tokens always carry their own.
APN_PRODUCTION=false

# Firebase Cloud Messaging (FCM), used by the Nafyn Android app for notifications, Live Updates (request
# progress, release countdowns) and the Now Playing notification of another device. Leave empty to disable FCM
# (every Android push is then skipped silently). The value is the path (relative to the working directory) of
# the service-account key of the Firebase project the Android app was built with: Firebase console -> Project
# settings -> Service accounts -> Generate new private key. It is a credential: keep it out of git, mode 600.
# Not to be confused with google-services.json, which goes in the Android app.
FCM_SERVICE_ACCOUNT_FILE=

# Set to "false" to stop this replica running the release-subscription scheduler (countdown Live Activities and
# "out now" notifications, server/plugins/notificationJobs.ts). Safe to run on several replicas at once.
NAFYN_NOTIFICATION_SCHEDULER=

# Nafyn checks this configuration at every boot and logs what is missing or wrong (server/utils/envCheck.ts).
# `bun run check:env` prints the full report on demand and exits non-zero on errors. Set to "false" to silence
# the boot-time check.
NAFYN_ENV_CHECK=

# Catalog search (server/utils/search/config.ts). Every value is optional; the defaults are tuned, change them
# only if results are too strict or too loose.
# relevance a result needs at all (0..1), and the artist similarity below which a result for another artist is dropped
NAFYN_SEARCH_MIN_RELEVANCE=
NAFYN_SEARCH_ARTIST_FLOOR=
# `bestResult` is set on the top result only if it scores at least this and beats the runner-up by the margin
NAFYN_SEARCH_BEST_MIN_SCORE=
NAFYN_SEARCH_BEST_MARGIN=
# candidates asked from MusicBrainz per search (max 100)
NAFYN_SEARCH_CANDIDATE_POOL=
# comma-separated words that mark a "best of" compilation, added to the built-in multilingual list
NAFYN_SEARCH_COMPILATION_KEYWORDS=
# stopword languages used for matching, from: en,fr,de,es,it,pt,ru
NAFYN_SEARCH_STOPWORD_LANGUAGES=
# preference order when results tie, from: album,ep,single,broadcast,other
NAFYN_SEARCH_PRIMARY_TYPE_ORDER=

# Personalized recommendations: mixes ("Made For You") and the Discover page (server/utils/recommender/,
# server/core/rec*.ts). On by default for every user, who can turn it off under Settings -> Privacy & Security.
# Every value below is optional; these are the defaults. `bun run check:env` reports values that were ignored.
# "false" switches the whole recommender off on this instance (no mixes, no Discover page, no outbound calls)
NAFYN_REC_ENABLED=
# "false" stops this replica running the recommender's jobs. Run them on ONE replica: it holds the ranking
# models' online updates in memory before saving them
NAFYN_REC_SCHEDULER=
# seed of the deterministic parts (clustering restarts, model initialization)
# NAFYN_REC_SEED=7
# -- mixes --
# at most this many mixes per user (1-10), tracks per mix, and the share of tracks the user already has
# NAFYN_REC_MAX_MIXES=8
# NAFYN_REC_MIX_LENGTH=40
# NAFYN_REC_FAMILIAR_RATIO=0.6
# how fast old listening fades (days for its weight to halve)
# NAFYN_REC_RECENCY_HALF_LIFE_DAYS=45
# energy shape of a mix's order: arc (warm up, peak, cool down), rise, wave, flat
# NAFYN_REC_ENERGY_ARC=arc
# a user's mixes are rebuilt after this many hours, or sooner after this many new signals (saves, playlist
# adds, plays)
# NAFYN_REC_REFRESH_HOURS=24
# NAFYN_REC_REFRESH_MIN_EVENTS=40
# catalogue candidates considered per mix, and how many of the best get a preview analysed for their audio
# NAFYN_REC_CANDIDATES_PER_MODE=120
# NAFYN_REC_AUDIO_SHORTLIST=12
# -- Discover ranking (contextual bandit): Score = predicted reward + LAMBDA * uncertainty --
# linucb | neural_ts | neural_ucb. Changing it on a running instance takes effect only once the new kind
# passes the offline evaluation gate on logged traffic
# NAFYN_REC_POLICY=linucb
# exploration coefficient (LinUCB, NeuralUCB); Neural Thompson Sampling draws it from N(0, TS_NU^2)
# NAFYN_REC_LAMBDA=0.8
# NAFYN_REC_TS_NU=0.5
# ridge regularizer of the models
# NAFYN_REC_RIDGE=1
# logging-time randomization, what makes offline evaluation possible: epsilon | softmax | none
# NAFYN_REC_EXPLORATION=epsilon
# NAFYN_REC_EPSILON_START=0.2
# NAFYN_REC_EPSILON_END=0.05
# NAFYN_REC_EPSILON_DECAY_STEPS=5000
# NAFYN_REC_SOFTMAX_TEMPERATURE=0.1
# neural models: mlp | fm, their uncertainty (diag | last_layer), hidden layer widths, learning rate
# NAFYN_REC_NEURAL_MODEL=mlp
# NAFYN_REC_NEURAL_UNCERTAINTY=diag
# NAFYN_REC_HIDDEN_SIZES=32,32
# NAFYN_REC_LEARNING_RATE=0.005
# a listen longer than this is a success; feedback counts this many minutes after the page was shown
# NAFYN_REC_REWARD_THRESHOLD_MS=30000
# NAFYN_REC_REWARD_WINDOW_MINUTES=30
# "true": graded rewards (a long listen scores more than one just past the threshold) instead of 0/1
# NAFYN_REC_GRADED_REWARD=false
# -- offline evaluation and safe updates (daily, server/core/recOffline.ts) --
# importance-weight clip, cross-fitting folds and reward model (fm | mlp) of the doubly robust estimator
# NAFYN_REC_IPS_CLIP=50
# NAFYN_REC_DR_FOLDS=5
# NAFYN_REC_REWARD_MODEL=fm
# a candidate replaces the serving model only if it is, with 95 % confidence, not worse by more than this
# (absolute engagement rate), on at least this many logged decisions, over this many days of logs
# NAFYN_REC_GATE_MAX_REGRESSION=0.005
# NAFYN_REC_GATE_MIN_DECISIONS=1000
# NAFYN_REC_EVALUATION_DAYS=30
# what the Discover page showed each user is deleted after this many days
# NAFYN_REC_DECISION_RETENTION_DAYS=90
