# secret used to sign/verify auth JWTs, keep this private and long/random in production
JWT_SECRET=change-me-to-a-long-random-string

# MySQL connection - the database is created automatically on first boot if it doesn't exist
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nafyn

# Nafyn downloads through a self-hosted slskd instance (https://github.com/slskd/slskd), not the raw Soulseek network directly.
# URL of your slskd instance's web/API port (default port: 5030)
SOULSEEK_HOST=http://127.0.0.1:5030
# slskd web UI login, create a dedicated/throwaway account on it, never reuse a personal Soulseek login
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
# local, readable path to slskd's own downloads directory (e.g. an SMB/NFS mount if slskd runs on another machine).
# required because slskd's API can drive downloads but doesn't serve the finished file's bytes back over HTTP.
SOULSEEK_DOWNLOADS_PATH=

# AcoustID client API key (free, get one at https://acoustid.org/my-applications), used to verify downloaded audio actually matches the requested MusicBrainz recording
ACOUSTID_API_KEY=

# Last.fm API key (free, get one at https://www.last.fm/api/account/create), used for artist bios/images
# on the artist page, search results, and Subsonic's getArtistInfo2. Artist pages/search still work without
# it, just without bios or images.
LASTFM_API_KEY=

# Song metadata providers, queried from the search bar (text, ISRC, platform IDs and links) and
# GET /api/v1/metadata/search. Deezer, iTunes and ReccoBeats are public and always on. The three below are
# optional: leave one empty and that provider is skipped silently.
# Discogs personal access token (free, https://www.discogs.com/settings/developers) - genres/styles, labels, tracklists
DISCOGS_TOKEN=
# TheAudioDB API key - "123" is the free public test key, a personal key only raises limits - moods, descriptions, MusicBrainz IDs
THEAUDIODB_API_KEY=
# Genius client access token (free, https://genius.com/api-clients, "Generate Access Token") - credits, descriptions
GENIUS_ACCESS_TOKEN=

# Comma-separated hostnames whose resolved IPs are exempt from the login/register rate limits.
# Leave empty unless you specifically need it - every entry here is an IP that can brute-force passwords freely.
DOMAINS_WHITELIST=

# Number of reverse proxies in front of Nafyn (nginx/Caddy/Traefik/Cloudflare). Leave at 0 when Nafyn is
# directly exposed. This gates whether X-Forwarded-For is trusted at all: with it wrong (or unset behind a
# proxy) every client shares one rate-limit bucket; with it set while NOT behind a proxy, anyone can forge
# the header and bypass rate limiting entirely.
TRUST_PROXY=0

# Set to "true" to publish the auto-generated OpenAPI spec and Scalar docs UI in production.
# Off by default: the spec enumerates every endpoint, parameter and auth requirement to anonymous visitors.
NAFYN_PUBLIC_OPENAPI=false

# GDPR art. 13: the privacy notice at /privacy ships with Nafyn, but only you know who is running this
# instance and how to be reached about personal data. Both are optional - the page then tells visitors
# plainly that no contact details were published, which is worse than filling them in.
# Name of the person/organisation running this instance (the data controller)
NAFYN_PRIVACY_CONTROLLER=
# How to reach them about data requests: an email address, a URL, anything a person can act on
NAFYN_PRIVACY_CONTACT=

# Set to "false" to stop this replica running the retention sweeps (server/plugins/retentionJobs.ts).
# Leave unset on a single-instance install - the sweeps are what keep data from being kept longer than it
# is needed (GDPR art. 5(1)(e)), so at least one replica must be running them.
NAFYN_RETENTION_SCHEDULER=
