# secret used to sign/verify auth JWTs, keep this private and long/random in production
JWT_SECRET=change-me-to-a-long-random-string

# MySQL connection - the database is created automatically on first boot if it doesn't exist
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nafyn

# Nafyn downloads through a self-hosted slskd instance (https://github.com/slskd/slskd), not the raw Soulseek network directly.
# URL of your slskd instance's web/API port (default port: 5030)
SOULSEEK_HOST=http://127.0.0.1:5030
# slskd web UI login, create a dedicated/throwaway account on it, never reuse a personal Soulseek login
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
# local, readable path to slskd's own downloads directory (e.g. an SMB/NFS mount if slskd runs on another machine).
# required because slskd's API can drive downloads but doesn't serve the finished file's bytes back over HTTP.
SOULSEEK_DOWNLOADS_PATH=

# AcoustID client API key (free, get one at https://acoustid.org/my-applications), used to verify downloaded audio actually matches the requested MusicBrainz recording
ACOUSTID_API_KEY=

# Last.fm API key (free, get one at https://www.last.fm/api/account/create), used for artist bios/images
# on the artist page, search results, and Subsonic's getArtistInfo2. Artist pages/search still work without
# it, just without bios or images.
LASTFM_API_KEY=

# Comma-separated hostnames whose resolved IPs are exempt from the login/register rate limits.
# Leave empty unless you specifically need it - every entry here is an IP that can brute-force passwords freely.
DOMAINS_WHITELIST=

# Number of reverse proxies in front of Nafyn (nginx/Caddy/Traefik/Cloudflare). Leave at 0 when Nafyn is
# directly exposed. This gates whether X-Forwarded-For is trusted at all: with it wrong (or unset behind a
# proxy) every client shares one rate-limit bucket; with it set while NOT behind a proxy, anyone can forge
# the header and bypass rate limiting entirely.
TRUST_PROXY=0

# Set to "true" to publish the auto-generated OpenAPI spec and Scalar docs UI in production.
# Off by default: the spec enumerates every endpoint, parameter and auth requirement to anonymous visitors.
NAFYN_PUBLIC_OPENAPI=false
# ---- Settings -> Import (bring a library over from another streaming service) ----
# Every service below is optional: one without credentials just shows up greyed out, and "Import from a file"
# (CSV/JSON/text exports) always works. OAuth services redirect back to <public URL>/transfer/callback -
# register exactly that URL as the redirect/callback URI in each developer console.
# Public origin of this Nafyn install (e.g. https://music.example.com). Falls back to the request's own origin.
NAFYN_PUBLIC_URL=

# Spotify (https://developer.spotify.com/dashboard) - PKCE, so the secret is optional
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music (https://developer.apple.com/account/resources/authkeys/list) - a MusicKit key: Team ID, Key ID
# and the .p8 private key's contents (newlines may be written as \n)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Deezer - optional: without an app, users import from their public profile link instead
# (Deezer no longer accepts new app registrations)
DEEZER_APP_ID=
DEEZER_APP_SECRET=

# SoundCloud (https://soundcloud.com/you/apps)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# YouTube Music, via the YouTube Data API v3 (https://console.cloud.google.com/apis/credentials, OAuth
# client of type "Web application", with the YouTube Data API v3 enabled on the project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TIDAL (https://developer.tidal.com/dashboard) - PKCE, so the secret is optional
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Amazon Music Web API - closed beta: a Login with Amazon security profile approved for the Music API;
# AMAZON_MUSIC_API_KEY is that security profile's id (sent as x-api-key)
AMAZON_MUSIC_CLIENT_ID=
AMAZON_MUSIC_CLIENT_SECRET=
AMAZON_MUSIC_API_KEY=

# Napster (https://developer.napster.com)
NAPSTER_API_KEY=
NAPSTER_API_SECRET=

# Set to "false" on extra replicas so only one process runs the import worker
NAFYN_TRANSFER_WORKER=
